{
    "name": "mutant-language-tools",
    "displayName": "Mutant Language Tools",
    "description": "Language tools for Mutant, powered by a dedicated language server: strict canonical formatting, rich diagnostics (OS-aware platform warnings, unreachable code, unused/undefined/duplicate checks, semicolons), hover with capability categories, completion, semantic highlighting, go-to-definition, references, and rename.",
    "version": "0.1.0",
    "publisher": "aoiflux",
    "icon": "images/icon-128.png",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/aoiflux/mutant.git"
    },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Formatters",
        "Snippets"
    ],
    "keywords": [
        "mutant",
        "forensics",
        "dfir",
        "security",
        "language server",
        "lsp",
        "formatter",
        "linter"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "mutant",
                "aliases": [
                    "Mutant",
                    "mutant"
                ],
                "extensions": [
                    ".mut"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mutant",
                "scopeName": "source.mutant",
                "path": "./syntaxes/mutant.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "mutant",
                "path": "./snippets/mutant.json"
            }
        ],
        "taskDefinitions": [
            {
                "type": "mutant",
                "required": [
                    "command"
                ],
                "properties": {
                    "command": {
                        "type": "string",
                        "enum": [
                            "gen",
                            "run",
                            "release"
                        ],
                        "description": "gen = compile a .mut to encrypted .mu bytecode; run = execute a compiled .mu; release = build a standalone executable."
                    },
                    "src": {
                        "type": "string",
                        "description": "Source (.mut) or bytecode (.mu) file. Defaults to the active editor file."
                    },
                    "os": {
                        "type": "string",
                        "enum": [
                            "windows",
                            "linux",
                            "darwin"
                        ],
                        "description": "release only: target operating system."
                    },
                    "arch": {
                        "type": "string",
                        "enum": [
                            "amd64",
                            "arm64"
                        ],
                        "description": "release only: target architecture."
                    },
                    "mutation": {
                        "type": "number",
                        "description": "Polymorphic mutation level (0-10)."
                    },
                    "password": {
                        "type": "string",
                        "description": "Optional encryption/decryption password."
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Additional raw CLI arguments appended to the command."
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "mutant.openSmokeFile",
                "title": "Mutant: Open Smoke File",
                "category": "Mutant"
            },
            {
                "command": "mutant.runSmokeChecks",
                "title": "Mutant: Run LSP Smoke Checks",
                "category": "Mutant"
            },
            {
                "command": "mutant.showLspStatus",
                "title": "Mutant: Show LSP Status",
                "category": "Mutant"
            },
            {
                "command": "mutant.showLspLogs",
                "title": "Mutant: Show LSP Logs",
                "category": "Mutant"
            },
            {
                "command": "mutant.restartLsp",
                "title": "Mutant: Restart LSP",
                "category": "Mutant"
            },
            {
                "command": "mutant.copyLspLogs",
                "title": "Mutant: Copy LSP Logs",
                "category": "Mutant"
            },
            {
                "command": "mutant.formatDocument",
                "title": "Mutant: Format Document",
                "category": "Mutant"
            }
        ],
        "configuration": {
            "title": "Mutant",
            "properties": {
                "mutant.languageServer.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path or command name for the Mutant language server executable. Leave empty to auto-detect packaged platform binary first, then workspace/PATH."
                },
                "mutant.languageServer.args": {
                    "type": "array",
                    "default": [],
                    "description": "Additional command line arguments passed to the Mutant language server.",
                    "items": {
                        "type": "string"
                    }
                },
                "mutant.cli.path": {
                    "type": "string",
                    "default": "mutant",
                    "description": "Path or command name for the Mutant CLI, used by the Mutant build/run/release tasks. The CLI is separate from the bundled language server and is expected on PATH by default."
                },
                "mutant.strictFormatting": {
                    "type": "boolean",
                    "default": true,
                    "description": "Format Mutant files using the canonical style: four-space indentation, spaces only, and a semicolon after every statement that requires one. This is a master on/off switch, not a style option — Mutant formatting is deliberately not configurable, so that the same source always produces the same bytes. Set to false to disable Mutant formatting entirely."
                },
                "mutant.format.onType.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable on-type formatting for Mutant files. Off by default: on-type formatting reformats the whole document on every ';', '}' and newline, which is disruptive while typing. Format-on-save is enabled by default instead."
                },
                "mutant.lint.rules.duplicateTopLevelDeclaration.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for duplicate top-level declaration lint diagnostics. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.unusedDeclaration.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for unused top-level declaration lint diagnostics. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.undefinedDeclaration.severity": {
                    "type": "string",
                    "default": "error",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for undefined identifier lint diagnostics. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.semicolon.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for missing or redundant semicolon diagnostics. Both come with a quick fix. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.nestingComplexity.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for deep nesting diagnostics in function bodies. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.unreachableCode.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for unreachable-code diagnostics (statements after an unconditional return/break/continue). Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.platformSupport.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for platform-support diagnostics: warns when a program calls a builtin that is not supported on the operating system the language server is running on (for example a Windows/Linux-only builtin used on macOS). Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.builtinArity.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for builtin arity diagnostics: warns when a builtin with a known fixed argument count is called with the wrong number of arguments (for example abs(1, 2) or clamp(x)). Only a curated, verified subset of builtins is checked. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.builtinArgType.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for builtin argument-type diagnostics: warns when a builtin is passed a value of a type its parameter cannot accept (for example str_upper(42) or len(true)). Only builtins whose parameter types have been verified against their implementation are checked, and only arguments whose type is certain — a literal, or a name that is never reassigned. Set to 'off' to suppress the rule."
                },
                "mutant.lint.rules.builtinSingleReturn.severity": {
                    "type": "string",
                    "default": "warning",
                    "enum": [
                        "error",
                        "warning",
                        "information",
                        "hint",
                        "off"
                    ],
                    "description": "Severity for single-return binding diagnostics: warns when several names are bound from a builtin that returns one value rather than a (value, err) pair (for example let updated, err = push(items, x)). Nothing fails at runtime — if the value is an array the binding takes it apart, and otherwise the extra names are always null, so an if (err) check never fires. Set to 'off' to suppress the rule."
                }
            }
        },
        "configurationDefaults": {
            "[mutant]": {
                "editor.formatOnSave": true,
                "editor.formatOnType": false
            }
        },
        "menus": {
            "commandPalette": [
                {
                    "command": "mutant.formatDocument",
                    "when": "editorLangId == mutant"
                }
            ],
            "editor/context": [
                {
                    "command": "mutant.formatDocument",
                    "when": "editorLangId == mutant",
                    "group": "1_modification"
                }
            ]
        },
        "keybindings": [
            {
                "command": "mutant.restartLsp",
                "key": "ctrl+alt+r",
                "mac": "cmd+alt+r",
                "when": "editorLangId == mutant"
            }
        ]
    },
    "scripts": {
        "prepare:lsp-bins": "node ./scripts/stage-lsp-binaries.mjs",
        "check:lsp-bins": "node ./scripts/stage-lsp-binaries.mjs --check",
        "esbuild": "node ./esbuild.mjs",
        "compile": "node ./esbuild.mjs --production",
        "watch": "node ./esbuild.mjs --watch",
        "compile-tests": "tsc -p ./",
        "vscode:prepublish": "npm run prepare:lsp-bins && npm run compile",
        "lint": "eslint src --ext ts",
        "pretest": "npm run compile-tests && npm run lint",
        "test": "node ./out/test/runTest.js",
        "package": "node ./scripts/package-targets.mjs"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.14.2",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^8.2.0",
        "@typescript-eslint/parser": "^8.2.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.2.0",
        "esbuild": "^0.24.0",
        "eslint": "^9.8.0",
        "glob": "^11.0.3",
        "mocha": "^11.7.4",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}
