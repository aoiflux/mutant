{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mutant",
  "scopeName": "source.mutant",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#typeDeclarations"
    },
    {
      "include": "#typeUsage"
    },
    {
      "include": "#functionDeclarations"
    },
    {
      "include": "#macroDeclarations"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#fieldAccess"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mutant",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.mutant",
          "begin": "(?<![A-Za-z0-9_])r\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.triple.mutant",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.mutant",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.mutant",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.mutant"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.mutant"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.mutant",
          "begin": "(?<![A-Za-z0-9_])r\"",
          "end": "\""
        },
        {
          "name": "string.quoted.double.mutant",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mutant",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.mutant",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.mutant"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.mutant"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.mutant",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.mutant",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mutant",
          "match": "\\b(?:fn|let|if|else|match|return|for|while|in|break|continue|macro|import)\\b"
        }
      ]
    },
    "typeDeclarations": {
      "patterns": [
        {
          "name": "meta.declaration.type.mutant",
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.mutant"
            },
            "2": {
              "name": "entity.name.type.mutant"
            }
          }
        }
      ]
    },
    "functionDeclarations": {
      "patterns": [
        {
          "name": "meta.declaration.function.mutant",
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*=\\s*)(fn)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.mutant"
            },
            "2": {
              "name": "entity.name.function.mutant"
            },
            "4": {
              "name": "storage.type.function.mutant"
            }
          }
        }
      ]
    },
    "macroDeclarations": {
      "patterns": [
        {
          "name": "meta.declaration.macro.mutant",
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*=\\s*)(macro)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.mutant"
            },
            "2": {
              "name": "entity.name.function.macro.mutant"
            },
            "4": {
              "name": "storage.type.macro.mutant"
            }
          }
        }
      ]
    },
    "typeUsage": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\{)",
          "name": "entity.name.type.mutant"
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\b(?=\\s*\\.)",
          "name": "entity.name.type.mutant"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.mutant",
          "match": "\\b(?:http_conn_read_response_head|http_conn_read_request_head|bytes_cursor_read_u16_be|bytes_cursor_read_u16_le|bytes_cursor_read_u32_be|bytes_cursor_read_u32_le|bytes_cursor_read_u64_be|bytes_cursor_read_u64_le|detect_suspicious_files|http_conn_read_response|http_conn_read_request|net_tls_upgrade_client|net_tls_upgrade_server|detect_network_beacon|table_list_partitions|zlib_decompress_bytes|bytes_cursor_read_u8|case_manifest_verify|net_flow_reconstruct|ntfs_read_file_bytes|regex_capture_groups|security_diagnostics|table_partition_info|xfat_read_file_bytes|base64_decode_bytes|bytes_char_from_int|bytes_int_from_char|ext_read_file_bytes|fat_read_file_bytes|hfs_read_file_bytes|http_build_response|http_parse_response|net_conn_read_bytes|net_tls_fingerprint|process_memory_scan|timestamp_normalize|xfs_read_file_bytes|bytes_write_u16_be|bytes_write_u16_le|bytes_write_u32_be|bytes_write_u32_le|bytes_write_u64_be|bytes_write_u64_le|detect_persistence|fs_extract_strings|http_build_request|http_parse_request|mem_find_shellcode|net_os_fingerprint|process_open_files|sqlite_query_bytes|vhdi_read_at_bytes|aes_decrypt_bytes|browser_downloads|bytes_cursor_seek|bytes_cursor_tell|bytes_read_u16_be|bytes_read_u16_le|bytes_read_u32_be|bytes_read_u32_le|bytes_read_u64_be|bytes_read_u64_le|email_attachments|ewf_read_at_bytes|raw_read_at_bytes|text_jaro_winkler|tls_generate_cert|base64url_decode|base64url_encode|bytes_cursor_eof|bytes_cursor_new|db_shortest_path|detect_injection|evtx_parse_bytes|hashset_contains|hex_decode_bytes|hive_list_values|ndjson_stringify|net_connect_scan|net_listen_close|net_pcap_analyze|reg_deleted_keys|text_levenshtein|timesketch_event|assert_contains|bin_dwarf_parse|bin_macho_parse|browser_cookies|browser_history|bytes_to_string|db_add_artifact|db_add_relation|detect_priv_esc|is_valid_domain|net_capture_raw|net_tls_connect|ntfs_list_files|process_modules|process_threads|reg_enum_values|shimcache_parse|str_starts_with|str_trim_prefix|str_trim_suffix|string_to_bytes|text_fuzzy_find|text_similarity|tls_generate_ca|vhdi_map_offset|xfat_list_files|zlib_decompress|bodyfile_parse|db_query_nodes|domain_extract|email_spf_dkim|ext_list_files|fat_list_files|hfs_list_files|hive_get_value|hive_list_keys|json_stringify|jumplist_parse|lua_run_string|mem_read_bytes|msgpack_encode|net_conn_close|net_conn_write|net_tls_listen|ntfs_read_file|prefetch_parse|protobuf_parse|regex_find_all|report_section|sandbox_status|str_trim_right|tar_read_bytes|timeline_merge|toml_stringify|ws_write_frame|xfat_read_file|xfs_list_files|yaml_parse_all|yaml_stringify|zip_read_bytes|amcache_parse|base32_decode|base32_encode|base64_decode|base64_encode|bin_elf_parse|bin_yara_scan|bytes_cstr_at|case_evidence|case_manifest|chan_try_recv|csv_stringify|db_index_prop|email_headers|ext_read_file|fat_read_file|fs_read_bytes|hashset_close|hfs_read_file|hive_key_info|ip_is_private|msgpack_parse|net_conn_info|net_conn_read|net_dns_query|ntfs_metadata|reg_enum_keys|reg_get_value|regex_replace|report_render|str_ends_with|str_pad_right|str_trim_left|text_contains|timeline_sort|tls_sign_cert|vhdi_metadata|with_resource|ws_accept_key|ws_read_frame|xfat_metadata|xfs_read_file|zlib_compress|bin_pe_parse|bin_sections|cache_delete|db_open_disk|debug_status|ewf_metadata|ext_metadata|extract_iocs|fat_metadata|go_buildinfo|gunzip_bytes|hashset_load|hfs_metadata|http_request|lua_run_file|lua_run_http|ndjson_parse|net_syn_scan|net_udp_scan|policy_allow|policy_rules|policy_trace|process_hash|process_kill|process_list|process_tree|raw_metadata|reg_timeline|report_table|sqlite_query|stix_pattern|str_pad_left|syslog_parse|text_replace|vhdi_read_at|xfs_metadata|aes_decrypt|aes_encrypt|before_each|bin_entropy|bin_imports|bin_strings|bytes_slice|cache_clear|cache_close|cache_stats|case_verify|cbor_encode|cmd_builder|db_add_edge|db_add_node|db_timeline|email_parse|event_kinds|events_from|ewf_read_at|exec_string|fs_metadata|go_build_id|hash_blake2|hash_sha256|hash_sha512|mem_find_pe|mem_strings|net_connect|net_resolve|parse_float|plist_parse|policy_eval|policy_load|process_env|raw_read_at|regex_match|report_list|report_text|stix_bundle|str_char_at|str_reverse|table_close|tar_entries|time_format|tld_extract|zip_entries|after_each|assert_err|cache_keys|cache_open|case_close|case_write|cbor_parse|chan_close|cidr_hosts|email_urls|evtx_parse|fs_deleted|fs_entropy|go_symbols|hash_crc32|hex_decode|hex_encode|hive_close|ip_in_cidr|ip_version|json_parse|jwt_decode|net_accept|net_banner|net_listen|ntfs_close|ocsf_event|pem_decode|rand_bytes|random_hex|regex_find|report_new|serve_conn|str_format|str_repeat|str_substr|table_open|text_count|text_index|text_split|time_parse|toml_parse|url_decode|url_encode|vhdi_close|x509_parse|xfat_close|yaml_parse|assert_eq|assert_ne|assert_ok|bin_is_go|bytes_get|bytes_hex|bytes_len|cache_get|cache_put|case_note|case_open|chan_recv|chan_send|csv_parse|der_parse|ecs_event|ewf_close|ext_close|fat_close|from_base|fs_append|fs_delete|fs_exists|hash_sha1|hfs_close|hive_open|http_post|int_to_ip|ip_to_int|lnk_parse|mft_parse|net_serve|net_spawn|ntfs_open|parse_int|raw_close|reg_close|serve_arg|str_lower|str_title|str_upper|tar_close|task_done|task_wait|time_diff|time_unix|to_string|vhdi_open|xfat_open|xfs_close|xml_parse|zip_close|chan_new|contains|db_close|db_query|db_stats|ewf_open|ext_open|fat_open|fs_carve|fs_magic|fs_mkdir|fs_write|go_types|hash_md5|hfs_open|http_get|index_of|mem_read|mem_scan|net_dial|rand_int|raw_open|reg_open|sleep_ms|str_join|str_trim|tar_open|tar_read|time_add|time_now|to_float|xfs_open|xml_find|zip_open|zip_read|cmd_add|cmd_run|db_open|entries|flatten|fs_copy|fs_diff|fs_hash|fs_list|fs_move|fs_read|fs_stat|fs_walk|has_key|imphash|is_null|lm_hash|mactime|math_pi|mem_map|nt_hash|reverse|sort_by|time_ms|to_base|to_bool|type_of|uuid_v4|uuid_v7|assert|concat|db_bfs|defang|delete|filter|gunzip|math_e|nanoid|reduce|refang|to_int|unique|values|clamp|error|first|floor|merge|peach|putln|range|round|slice|spawn|ceil|each|fail|gets|gzip|help|hmac|keys|last|pmap|push|putf|rand|rest|sort|sqrt|test|abs|avg|get|ja3|len|map|max|min|mod|pop|pow|set|sum|zip)\\b(?=\\s*\\()"
        }
      ]
    },
    "fieldAccess": {
      "patterns": [
        {
          "name": "meta.property-access.mutant",
          "match": "\\.\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.mutant"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.mutant",
          "match": "=>|<<=|>>=|<<|>>|==|!=|<=|>=|&&|\\|\\||&=|\\|=|\\^=|\\+=|-=|\\*=|/=|%=|\\+\\+|--|[+\\-*/%<>!=&|^~]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.mutant",
          "match": ","
        },
        {
          "name": "punctuation.separator.key-value.mutant",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.mutant",
          "match": ";"
        },
        {
          "name": "punctuation.definition.group.mutant",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
