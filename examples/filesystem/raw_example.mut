// mutant:sweep needs-input -- opens ./disk.raw, a raw disk image the repository does not ship

let opened, open_err = raw_open("./disk.raw");
if (open_err) {
    putln("raw_open failed:", open_err);
    return;
}

let handle = opened["handle"];
putf("RAW opened (handle=%s)\n", handle);

let meta, meta_err = raw_metadata(handle);
if (meta_err) {
    putln("raw_metadata failed:", meta_err);
    return;
}

putf("RAW metadata:\n");
putf("  file_size=%d\n", meta["file_size"]);
putf("  assumed_sector_size=%d\n", meta["assumed_sector_size"]);

let first, read_err = raw_read_at(handle, 0, 512);
if (read_err) {
    putln("raw_read_at failed:", read_err);
    return;
}

putf("First 512 bytes (string rendering):\n%s\n", first);

let closed, close_err = raw_close(handle);
if (close_err) {
    putln("raw_close failed:", close_err);
    return;
}

putf("Handle closed: %t\n", closed["closed"]);
