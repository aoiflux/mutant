// mutant:sweep needs-input -- opens ./disk.xfs, an XFS image the repository does not ship

let volume_path = "./disk.xfs";
let opened, open_err = xfs_open(volume_path);
if (open_err) {
    putln("xfs_open failed:", open_err);
    return;
}

let handle = opened["handle"];
putf("XFS opened: %s (handle=%s)\n", opened["path"], handle);

let items, list_err = xfs_list_files(handle, "/");
if (list_err) {
    putln("xfs_list_files failed:", list_err);
    return;
}

putf("Root entries:\n");
for (let i = 0; i < len(items); i = i + 1) {
    let e = items[i];
    putf("- %s (dir=%t, inode=%d)\n", e["path"], e["is_dir"], e["inode"]);
}

let target = "/etc/hosts";
let content, read_err = xfs_read_file(handle, target);
if (!read_err) {
    putf("File content from %s:\n%s\n", target, content);
}

let meta, meta_err = xfs_metadata(handle, target);
if (meta_err) {
    putln("xfs_metadata failed:", meta_err);
    return;
}

putf("Metadata:\n");
putf("  path=%s\n", meta["path"]);
putf("  name=%s\n", meta["name"]);
putf("  inode=%d\n", meta["inode"]);
putf("  format_version=%d\n", meta["format_version"]);
putf("  block_size=%d\n", meta["block_size"]);
putf("  inode_size=%d\n", meta["inode_size"]);
putf("  volume_blocks=%d\n", meta["volume_blocks"]);
putf("  root_inode=%d\n", meta["root_inode"]);
putf("  is_dir=%t\n", meta["is_dir"]);
putf("  size=%d\n", meta["size"]);

let closed, close_err = xfs_close(handle);
if (close_err) {
    putln("xfs_close failed:", close_err);
    return;
}

putf("Handle closed: %t\n", closed["closed"]);
