// mutant:sweep needs-input -- opens ./image.E01, an EWF evidence image the repository does not ship

let segments = ["./image.E01", "./image.E02"];
let opened, open_err = ewf_open(segments);
if (open_err) {
    putln("ewf_open failed:", open_err);
    return;
}

let handle = opened["handle"];
putf("EWF opened (handle=%s, segment_count=%d)\n", handle, opened["segment_count"]);

let meta, meta_err = ewf_metadata(handle);
if (meta_err) {
    putln("ewf_metadata failed:", meta_err);
    return;
}

putf("Metadata:\n");
putf("  version=%d.%d\n", meta["major_version"], meta["minor_version"]);
putf("  section_count=%d\n", meta["section_count"]);
putf("  is_encrypted=%t\n", meta["is_encrypted"]);
putf("  has_media=%t\n", meta["has_media"]);
putf("  bytes_per_sector=%d\n", meta["bytes_per_sector"]);
putf("  sectors_per_chunk=%d\n", meta["sectors_per_chunk"]);
putf("  number_of_sectors=%d\n", meta["number_of_sectors"]);
putf("  number_of_chunks=%d\n", meta["number_of_chunks"]);
putf("  total_logical_bytes=%d\n", meta["total_logical_bytes"]);

let first, read_err = ewf_read_at(handle, 0, 512);
if (read_err) {
    putln("ewf_read_at failed:", read_err);
    return;
}

putf("First 512 decoded bytes (string rendering):\n%s\n", first);

let closed, close_err = ewf_close(handle);
if (close_err) {
    putln("ewf_close failed:", close_err);
    return;
}

putf("Handle closed: %t\n", closed["closed"]);
