// mutant:sweep needs-input -- opens ./disk.vhdx, a VHDX image the repository does not ship

let image_path = "./disk.vhdx";
let opened, open_err = vhdi_open(image_path);
if (open_err) {
    putln("vhdi_open failed:", open_err);
    return;
}

let handle = opened["handle"];
putf("VHDI opened: %s (handle=%s)\n", opened["path"], handle);

let meta, meta_err = vhdi_metadata(handle);
if (meta_err) {
    putln("vhdi_metadata failed:", meta_err);
    return;
}

putf("Metadata:\n");
putf("  format=%s\n", meta["format"]);
putf("  disk_type=%s\n", meta["disk_type"]);
putf("  virtual_size=%d\n", meta["virtual_size"]);
putf("  block_size=%d\n", meta["block_size"]);
putf("  sector_size=%d\n", meta["sector_size"]);
putf("  identifier=%s\n", meta["identifier"]);
putf("  is_differencing=%t\n", meta["is_differencing"]);

let off_info, off_err = vhdi_map_offset(handle, 0);
if (off_err) {
    putln("vhdi_map_offset failed:", off_err);
} else {
    putf("Offset map @0: mapped=%t, file_offset=%d\n", off_info["mapped"], off_info["file_offset"]);
}

let bytes, read_err = vhdi_read_at(handle, 0, 512);
if (read_err) {
    putln("vhdi_read_at failed:", read_err);
    return;
}

putf("Read first 512 logical bytes (string rendering):\n%s\n", bytes);

let closed, close_err = vhdi_close(handle);
if (close_err) {
    putln("vhdi_close failed:", close_err);
    return;
}

putf("Handle closed: %t\n", closed["closed"]);
