// mutant:sweep needs-input -- opens ./disk.hfs, an HFS+ image the repository does not ship

let volume_path = "./disk.hfs";
let opened, open_err = hfs_open(volume_path);
if (open_err) {
    putln("hfs_open failed:", open_err);
    return;
}

let handle = opened["handle"];
putf("HFS opened: %s (handle=%s)\n", opened["path"], handle);

let items, list_err = hfs_list_files(handle, "/");
if (list_err) {
    putln("hfs_list_files failed:", list_err);
    return;
}

putf("Root entries:\n");
for (let i = 0; i < len(items); i = i + 1) {
    let e = items[i];
    putf("- %s (dir=%t, cnid=%d)\n", e["path"], e["is_dir"], e["cnid"]);
}

let target = "/etc/hosts";
let content, read_err = hfs_read_file(handle, target);
if (!read_err) {
    putf("File content from %s:\n%s\n", target, content);
}

let meta, meta_err = hfs_metadata(handle, target);
if (meta_err) {
    putln("hfs_metadata failed:", meta_err);
    return;
}

putf("Metadata:\n");
putf("  path=%s\n", meta["path"]);
putf("  name=%s\n", meta["name"]);
putf("  cnid=%d\n", meta["cnid"]);
putf("  kind=%s\n", meta["kind"]);
putf("  block_size=%d\n", meta["block_size"]);
putf("  total_blocks=%d\n", meta["total_blocks"]);
putf("  free_blocks=%d\n", meta["free_blocks"]);
putf("  file_count=%d\n", meta["file_count"]);
putf("  folder_count=%d\n", meta["folder_count"]);
putf("  is_dir=%t\n", meta["is_dir"]);
putf("  size=%d\n", meta["size"]);

let closed, close_err = hfs_close(handle);
if (close_err) {
    putln("hfs_close failed:", close_err);
    return;
}

putf("Handle closed: %t\n", closed["closed"]);
