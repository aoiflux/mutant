putln("=== Network Triage DNS + TLS ===");

let dns, err = net_dns_query("example.com", "A");
putln("dns:", dns, "err:", err);

// Both take an "host:port" address and a timeout in milliseconds. Written as
// (host, port) the port lands in the timeout and the address carries no port at
// all, which is a 443 ms dial of the wrong endpoint.
let tls, err = net_tls_fingerprint("example.com:443", 1500);
putln("tls_fingerprint:", tls, "err:", err);

// net_banner reads whatever the service announces; it sends no request of its
// own, so there is no payload argument.
let banner, err = net_banner("example.com:80", 1500);
putln("banner:", banner, "err:", err);
