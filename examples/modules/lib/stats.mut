// A module: an ordinary .mut file that another file imports.
//
// Nothing here is exported by a keyword. Every top-level name is reachable
// from an importing file as `stats.<name>`, except those beginning with `_`,
// which are private to this file.

// _total is private. An importing file that writes `stats._total` is a compile
// error naming this file -- the underscore is the whole export rule, so the
// mark travels with every mention of the name instead of living in a list
// somewhere else.
let _total = fn(values) {
	let sum = 0;
	for (let i = 0; i < len(values); i = i + 1) {
		sum = sum + values[i];
	}
	return sum;
};

let sum = fn(values) {
	return _total(values);
};

let mean = fn(values) {
	if (len(values) == 0) {
		return 0;
	}
	return _total(values) / len(values);
};

let largest = fn(values) {
	let best = values[0];
	for (let i = 1; i < len(values); i = i + 1) {
		if (values[i] > best) {
			best = values[i];
		}
	}
	return best;
};
